<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ErrorOr" Version="2.1.1" />
		<PackageReference Include="SkiaSharp" Version="4.151.2" />
	</ItemGroup>

	<Target Name="GenerateLocalizationKeys" BeforeTargets="BeforeBuild">
		<Exec Command="dotnet run --project ../Tools/LocalizationKeyGenerator/LocalizationKeyGenerator.csproj" />
	</Target>
</Project>
