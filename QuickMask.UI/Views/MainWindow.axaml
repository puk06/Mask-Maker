<sukiUi:SukiWindow xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:QuickMask.UI.ViewModels"
	xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
	xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
	xmlns:loc="using:QuickMask.UI.Localization"
	x:Class="QuickMask.UI.Views.MainWindow"
	x:DataType="vm:MainViewModel"
	DragDrop.AllowDrop="True"
	DragDrop.DragOver="WindowDragOver"
	DragDrop.Drop="WindowDrop"
	Title="{Binding WindowTitle}"
	Icon="avares://QuickMask/Assets/Internal/SoftwareIcon.png"
	Width="1440"
	Height="820"
	MinWidth="1060"
	MinHeight="700"
	FontFamily="Inter">

	<DockPanel>
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="{Binding [Main.MenuBar.UVImage.Title], Source={x:Static loc:Localizer.Instance}}">
				<MenuItem Header="{Binding [Main.MenuBar.UVImage.UnloadUV], Source={x:Static loc:Localizer.Instance}}" Command="{Binding UnloadUvImageCommand}"/>
			</MenuItem>
			<MenuItem Header="{Binding [Main.MenuBar.Tool.Title], Source={x:Static loc:Localizer.Instance}}">
				<MenuItem Header="{Binding [Main.MenuBar.Tool.DetectAllObjects], Source={x:Static loc:Localizer.Instance}}" Command="{Binding SelectAllObjectsCommand}"/>
			</MenuItem>
		</Menu>
		
		<Grid Grid.Row="0" ColumnDefinitions="*,340" ColumnSpacing="16" Margin="24" RowSpacing="16">
			<Grid Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="16">
				<Grid ColumnDefinitions="*,*" ColumnSpacing="16">
					<sukiUi:GlassCard Grid.Column="0">
						<Grid RowDefinitions="Auto,*">
							<TextBlock Text="{Binding [Main.SourceTexture.Label], Source={x:Static loc:Localizer.Instance}}" Foreground="#F5F5F5" FontSize="12" FontWeight="Bold" />

							<Border Grid.Row="1" Background="#121212" CornerRadius="6" Margin="0,12,0,0" PointerPressed="SourcePointerPressed">
								<Image Source="{Binding SourcePreview}" Stretch="Uniform" />
							</Border>
						</Grid>
					</sukiUi:GlassCard>

					<sukiUi:GlassCard Grid.Column="1">
						<Grid RowDefinitions="Auto,*">
							<TextBlock Text="{Binding [Main.MaskTexture.Label], Source={x:Static loc:Localizer.Instance}}" Foreground="#F5F5F5" FontSize="12" FontWeight="Bold" />
							<Border Grid.Row="1" Background="#121212" CornerRadius="6" Margin="0,12,0,0">
								<Image Source="{Binding MaskPreview}" Stretch="Uniform" />
							</Border>
						</Grid>
					</sukiUi:GlassCard>
				</Grid>

				<sukiUi:GlassCard Grid.Row="1">
					<TextBlock Text="{Binding Status}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
				</sukiUi:GlassCard>
			</Grid>

			<Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">
				<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
					<Button Classes="Flat" Content="{Binding [Main.LoadImage], Source={x:Static loc:Localizer.Instance}}" Command="{Binding OpenImageCommand}" />
					<Button Grid.Column="1" Classes="Outlined" Content="{Binding [Main.LoadUVImage], Source={x:Static loc:Localizer.Instance}}" Command="{Binding OpenUvImageCommand}" />
				</Grid>

				<sukiUi:GlassCard Grid.Row="1">
					<Grid RowDefinitions="Auto,*" RowSpacing="10">
						<Grid ColumnDefinitions="*,Auto">
							<Grid RowDefinitions="Auto,Auto">
								<TextBlock Text="{Binding [SelectionArea.Title], Source={x:Static loc:Localizer.Instance}}" FontSize="12" FontWeight="Bold" Foreground="#F5F5F5" />
								<TextBlock Grid.Row="1" Text="{Binding [SelectionArea.Description], Source={x:Static loc:Localizer.Instance}}" FontSize="11" Foreground="#909090" />
							</Grid>
							<TextBlock Grid.Column="1" Text="{Binding SelectionAreas.Count, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Foreground="#8AB4F8" VerticalAlignment="Center" />
						</Grid>
						
						<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="180">
							<ItemsControl ItemsSource="{Binding SelectionAreas}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Spacing="10"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>

								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:SelectionAreaViewModel">
										<sukiUi:GlassCard Classes="Primary" IsInteractive="True">
											<sukiUi:GlassCard.ContextMenu>
												<ContextMenu>
													<MenuItem Header="{Binding [SelectionArea.ContextMenu.ToggleAreaType], Source={x:Static loc:Localizer.Instance}}" Command="{Binding ToggleEraseCommand}" />
													<MenuItem Header="{Binding [SelectionArea.ContextMenu.Remove], Source={x:Static loc:Localizer.Instance}}" Command="{Binding RemoveCommand}" />
												</ContextMenu>
											</sukiUi:GlassCard.ContextMenu>

											<Grid ColumnDefinitions="Auto,10,*,Auto">
												<CheckBox IsChecked="{Binding IsEnabled}" />

												<Grid Grid.Column="2" RowDefinitions="Auto,Auto">
													<TextBlock Text="{Binding TypeText}" FontSize="16" FontWeight="Bold" Foreground="#F5F5F5" />
													<TextBlock Grid.Row="1" Text="{Binding PixelCountText }" FontSize="11" Foreground="#909090" />
												</Grid>

												<Grid Grid.Column="3" ColumnDefinitions="Auto,Auto" ColumnSpacing="3">
													<Button Content="{materialIcons:MaterialIconExt Kind=ArrowUp}" FontSize="16" Command="{Binding MoveUpCommand}" />
													<Button Grid.Column="1" Content="{materialIcons:MaterialIconExt Kind=ArrowDown}" FontSize="16" Command="{Binding MoveDownCommand}" />
												</Grid>
											</Grid>
										</sukiUi:GlassCard>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</Grid>
				</sukiUi:GlassCard>

				<Button Grid.Row="2" Classes="Outlined" Content="{Binding [SelectionArea.ClearSelection], Source={x:Static loc:Localizer.Instance}}" HorizontalAlignment="Stretch" Command="{Binding ClearSelectionsCommand}" />
				<Button Grid.Row="3" Classes="Flat Large" Content="{Binding [Main.GenerateMask], Source={x:Static loc:Localizer.Instance}}" HorizontalAlignment="Stretch" Command="{Binding SaveMaskCommand}" />
			</Grid>
		</Grid>
	</DockPanel>
</sukiUi:SukiWindow>
